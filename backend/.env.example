# Run npm run setup to generate local secrets. Never commit the resulting .env.
NODE_ENV=development
# deployment: development (local), review (public client test link with sandbox payments), production (live keys)
DEPLOYMENT_STAGE=development
PORT=5000
MONGODB_URI=YOUR_MONGODB_ATLAS_OR_REPLICA_SET_URI_WITH_DATABASE_NAME
AUTH_SECRET=GENERATE_WITH_NPM_RUN_SETUP
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=/api
# Student signup/login has no account-email verification gate. Forgot-password email still uses SMTP.
# Set only to the exact trusted reverse-proxy hop count. Never enable blind trust of forwarded IPs.
TRUST_PROXY_HOPS=0
CLIENT_ADMIN_NAME=Singh Academy Business Admin
CLIENT_ADMIN_EMAIL=admin@singhacademy.com
CLIENT_ADMIN_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
SUPER_ADMIN_NAME=Singh Academy Website Admin
SUPER_ADMIN_EMAIL=superadmin@singhacademy.com
SUPER_ADMIN_PASSWORD=GENERATE_WITH_NPM_RUN_SETUP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Singh Academy <no-reply@singhacademy.com>
# V47 supports verified hosted Stripe/PayPal checkout. Configure the settings below and validate on staging before enabling live sales.

# Development may preview email and skip the scanner. Hosted uploads require a configured scanner (ClamAV or Cloudmersive).
MAX_UPLOAD_MB=250
MAX_CONCURRENT_UPLOADS=2
MONGO_MAX_POOL=20
UPLOAD_SCAN_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_TIMEOUT_MS=120000
LOG_REQUESTS=false

# Hosted Stripe + PayPal checkout. For a public client-review link use NODE_ENV=production + DEPLOYMENT_STAGE=review + test/sandbox keys.
# For live sales switch DEPLOYMENT_STAGE=production and replace BOTH providers with live credentials before running payments:check --remote.
# Leave disabled until configured; no fake successful payments are simulated.
ONLINE_PAYMENTS_ENABLED=false
# Set true after BOTH providers are configured if the deployment must refuse partial payment setup.
PAYMENTS_REQUIRE_BOTH=false
# Public HTTPS origin that receives provider webhooks. For split hosting, prefer the direct backend origin.
PAYMENT_WEBHOOK_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional for a direct-merchant app; when supplied it is cross-checked on every PayPal order/capture.
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# V60.7 owned welcome, course-purchase and membership email outbox.
# SMTP acceptance is logged separately from inbox delivery; failures are retried.
# Expiry scanning stays at 15 minutes; email delivery polling defaults to 5 seconds.
STUDENT_NOTIFICATIONS_ENABLED=true

STUDENT_NOTIFICATION_POLL_MS=5000
SEND_SANDBOX_EMAILS=false
SANDBOX_EMAIL_ALLOWLIST=
# Public review without a provisioned ClamAV service: explicitly disable ALL new uploads.
# UPLOADS_ENABLED=false blocks admin images, assignment attachments and receipt uploads;
# existing media stays readable. Enable uploads only with the real scanner configured.
UPLOADS_ENABLED=true

# Sign-in uses email + password. No MFA or account-email-verification switches.

# V60.15 production security. Local defaults below do not enable hosted proof.
# Hosted staging: NODE_ENV=production + DEPLOYMENT_STAGE=review.
# Live: NODE_ENV=production + DEPLOYMENT_STAGE=production. Contradictory pairs fail.
# Signed frontend->backend client attribution: a SEPARATE random shared key.
# Enable only after verifying the trusted edge overwrites the chosen IP header.
# The matching frontend server needs the same SA_PROXY_SHARED_SECRET (never NEXT_PUBLIC_*).
SA_REQUIRE_PROXY_IDENTITY=false
SA_PROXY_SHARED_SECRET=
# Optional separate stable assessment revision secret; defaults to existing AUTH_SECRET.
# Do not rotate either secret casually: current assessment tokens would change.
ASSESSMENT_SECRET=
# Unknown PayPal order creation is NOT replayed by default. Keep 0 unless the
# merchant/API's actual PayPal-Request-Id retention is verified by the operator.
# An explicitly verified value must be <=18000 seconds; never guess retention.
# Normal first checkout and known-order Back/Cancel switching do not need replay.
PAYPAL_CREATE_REPLAY_SECONDS=0

# V60.15.3: existing private ClamAV remains the default; managed Hostinger can select cloudmersive.
# Configure these ONLY in the backend. Cloudmersive sends the quarantined file bytes over HTTPS.
# Account owner must review provider privacy, region, capacity and cost before public uploads.
UPLOAD_SCAN_PROVIDER=clamav
CLOUDMERSIVE_API_KEY=
# Default evaluation cap: 3.5 decimal MB. Raising this does NOT upgrade your provider account.
# With a suitable subscribed plan, 262144000 preserves the existing 250 MiB admin limit.
CLOUDMERSIVE_MAX_FILE_BYTES=3500000
