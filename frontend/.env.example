# Local browser requests stay same-origin. Only the server talks to port 5000.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:5000

# Hostinger: replace API_PROXY_TARGET with the exact HTTPS backend origin.
# Never put MongoDB, Stripe/PayPal secret keys, AUTH_SECRET or SMTP credentials here.
# API_PROXY_ALLOW_LOCAL_TEST_ONLY is reserved for the local automated test stack; leave unset on Hostinger.

# V60.15 OPTIONAL trusted-edge client attribution. SERVER ONLY, never NEXT_PUBLIC_*.
# This is a separate proxy key, NOT the backend AUTH_SECRET / database / provider keys.
# Leave the following unset for local development. For hosted handover, configure
# all together only AFTER confirming the edge overwrites the selected single-IP
# header and cannot be bypassed by a client reaching the app directly.
# SA_PROXY_SHARED_SECRET=<same strong random key as backend>
# SA_PROXY_CLIENT_IP_HEADER=<verified-hosting-edge-header-name>
# SA_PROXY_CLIENT_IP_VERIFIED=true
# SA_REQUIRE_PROXY_IDENTITY=true
# No default X-Forwarded-For trust; ambiguous comma-separated chains are refused.
